<Window x:Class="Kartova_hra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kartova_hra"
        mc:Ignorable="d"
        Title="MainWindow" Height="360" Width="353">
    <Grid HorizontalAlignment="Left" Width="637">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="159*"/>
            <ColumnDefinition Width="478*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="197*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="lblScore" HorizontalAlignment="Left" Height="31" Margin="31,12,0,0" TextWrapping="Wrap" Text="Body" VerticalAlignment="Top" Width="118" Background="White" FontWeight="Bold" FontSize="20" Grid.Row="1"/>
        <TextBlock x:Name="lblPacks" HorizontalAlignment="Left" Height="37" Margin="33,7,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="112" RenderTransformOrigin="-0.902,-0.259" Grid.RowSpan="2" FontSize="15"/>
        <TextBlock x:Name="lblMessage" HorizontalAlignment="Left" Height="50" Margin="10,18,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="175" Grid.RowSpan="2" FontFamily="Segoe UI Black" FontSize="10" Grid.Column="1"/>
        <Button x:Name="btnOpen" Content="Otvorit balicek" Click="btnOpen_Click" HorizontalAlignment="Left" Margin="36,217,0,0" VerticalAlignment="Top" Height="48" Width="106" Grid.Row="1" Background="#FFE2F607"/>
        <Button x:Name="btnRestart" Content="Restart" Click="btnRestart_Click" HorizontalAlignment="Left" Margin="16,217,0,0" VerticalAlignment="Top" Height="48" Width="103" Grid.Row="1" Background="#FFE2F607" Grid.Column="1"/>
        <ListBox x:Name="lstCards" HorizontalAlignment="Left" Height="176" Margin="36,36,0,0" VerticalAlignment="Top" Width="242" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="1" Grid.ColumnSpan="2"/>

    </Grid>
</Window>